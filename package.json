{
  "name": "url-porter",
  "version": "1.96.0",
  "description": "This extension lets you configure redirect rules and set a custom homepage. https://github.com/synle/url-porter",
  "homepage": "https://github.com/synle/url-porter",
  "bugs": {
    "url": "https://github.com/synle/url-porter/issues"
  },
  "license": "ISC",
  "author": "Sy Le",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synle/url-porter.git"
  },
  "type": "module",
  "main": "background.js",
  "scripts": {
    "dev": "npm run build:types && vite build --watch",
    "build": "npm run build:types && vite build",
    "build:types": "tsc",
    "bundle": "node scripts/bundle.js",
    "package": "npm run build && npm run bundle",
    "package-syle": "VITE_DEFAULT_URL_PORTER_SYNC_SERVER_URL=https://synle.github.io/fav/url-porter.json npm run package",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "validate": "npm test && npm run lint && npm run build && npm run format",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "prismjs": "^1.30.0",
    "react-simple-code-editor": "^0.14.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.5",
    "archiver": "^7.0.1",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.79.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sass": "^1.99.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-web-extension": "^4.5.1",
    "vitest": "^4.1.5"
  },
  "volta": {
    "node": "20.19.1"
  }
}
