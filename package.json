{
  "name": "url-porter",
  "type": "module",
  "main": "background.js",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitejs/plugin-react": "^5.2.0",
    "archiver": "^7.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.5.0",
    "prettier": "3.8.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sass": "^1.99.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vite-plugin-web-extension": "^4.5.1",
    "vitest": "^4.1.4"
  },
  "scripts": {
    "dev": "npm run build:types && vite build --watch",
    "build": "npm run build:types && vite build",
    "build:types": "tsc",
    "bundle": "npm version minor --no-git-tag-version && node scripts/bundle.js",
    "package": "npm run build && npm run bundle",
    "package-syle": "VITE_DEFAULT_URL_PORTER_SYNC_SERVER_URL=https://synle.github.io/fav/url-porter.json npm run package",
    "test": "vitest run",
    "lint": "eslint src/",
    "format": "prettier --write --print-width 140 --ignore-unknown --no-error-on-unmatched-pattern --cache '**/*.{js,jsx,ts,tsx,mjs,cjs,json,html,css,scss,less,md,yml,yaml,graphql,vue,xml}'",
    "validate": "npm test && npm run lint && npm run build && npm run format"
  },
  "author": "Sy Le",
  "license": "ISC",
  "description": "This extension lets you configure redirect rules and set a custom homepage.",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.10",
    "@mui/material": "^7.3.10",
    "prismjs": "^1.30.0",
    "react-simple-code-editor": "^0.14.1"
  },
  "volta": {
    "node": "20.19.1"
  },
  "version": "1.70.0"
}
