{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npm run validate 2>&1 | tail -20",
            "description": "Run quality checks after file changes"
          }
        ]
      }
    ],
    "PreCommit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm run validate 2>&1 | tail -20",
            "description": "Run quality checks before commit"
          }
        ]
      }
    ]
  }
}
